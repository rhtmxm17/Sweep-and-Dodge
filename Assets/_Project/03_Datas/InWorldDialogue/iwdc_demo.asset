  m_Script: {fileID: 11500000, guid: 435004dd231e575428d7f97ae754a4d8, type: 3}
  m_Name: iwdc_demo
  m_EditorClassIdentifier: SweepNDodge.Runtime::SweepNDodge.DotsBullets.InWorldDialogueCatalogSO
  SchemaVersion: 1
  Entries:
  - EntryKey: stage_01_start
    Enabled: 1
    Trigger: 1
    TargetKind: 0
    StageId: 1
    ThemeKey: 
    Priority: 10
    BlockingMode: 1
    RetryPolicy: 1
    FullVariant:
      Lines:
      - SpeakerKey: MC
        Text: "\uC7A5\uBE44 \uBC18\uC751\uC740 \uAD1C\uCC2E\uC544 \uBCF4\uC5EC.\r\nWASD\uB85C
          \uC6C0\uC9C1\uC774\uACE0, \uCEE4\uC11C\uB85C \uBC29\uD5A5\uC744 \uC7A1\uC544.
          \uD074\uB9AD\uD558\uBA74 \uADF8\uCABD\uC744 \uCCAD\uC18C\uD560 \uC218 \uC788\uC5B4."
        Anchor:
          Kind: 1
          StagePresentationStableId: 9001
          ScreenAnchor: 0
        MinHoldSec: 0.2
        AutoAdvanceSec: 0
      - SpeakerKey: MC
        Text: "\uC870\uAE08 \uD070 \uB369\uC5B4\uB9AC\uB3C4 \uD0C0\uC774\uBC0D\uC744
          \uB9DE\uCDB0 \uC815\uD655\uD788 \uACA8\uB204\uBA74 \uC4F8\uC5B4\uB2F4\uC744
          \uC218 \uC788\uC744\uAC70\uC57C."
        Anchor:
          Kind: 2
          StagePresentationStableId: 0
          ScreenAnchor: 3
        MinHoldSec: 0
        AutoAdvanceSec: 0
    RetryVariant:
      Lines:
      - SpeakerKey: MC
        Text: "\uC774\uBC88\uC5D4 \uB108\uBB34 \uC624\uB798 \uBA38\uBB34\uB974\uC9C0
          \uB9D0\uC790.\r\n\uBA3C\uC9C0\uD1B5\uC774 \uCC28\uBA74 \uBE44\uC6B0\uACE0,
          \uBE68\uAC04 \uB369\uC5B4\uB9AC\uB294 \uAC70\uB9AC\uB97C \uBC8C\uB9AC\uBA74
          \uB3FC."
        Anchor:
          Kind: 2
          StagePresentationStableId: 0
          ScreenAnchor: 4
        MinHoldSec: 0
        AutoAdvanceSec: 0
  - EntryKey: stage_02_start
    Enabled: 1
    Trigger: 1
    TargetKind: 0
    StageId: 2
    ThemeKey: 
    Priority: 10
    BlockingMode: 1
    RetryPolicy: 0
    FullVariant:
      Lines:
      - SpeakerKey: MC
        Text: "\uC774\uBC88\uC5D4 \uB450 \uAC1C\uC758 \uBC29\uC744 \uCCAD\uC18C\uD574\uC57C\uD574.\r\n\uBC29\uB9C8\uB2E4
          \uC704\uD5D8 \uC7A5\uCE58\uC758 \uD589\uB3D9\uC774 \uB2E4\uB974\uB2C8\uAE4C
          \uC870\uC2EC\uD558\uC790."
        Anchor:
          Kind: 1
          StagePresentationStableId: 9002
          ScreenAnchor: 0
        MinHoldSec: 0.2
        AutoAdvanceSec: 0
    RetryVariant:
      Lines: []
  - EntryKey: stage_01_clear
    Enabled: 1
